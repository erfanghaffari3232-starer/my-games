<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>جوک ساز</title>
    <style>
        body {
            background: #1a1a2e;
            text-align: center;
            padding: 30px;
            color: white;
            font-family: Tahoma;
        }
        .box {
            background: #1a1a1a;
            border-radius: 20px;
            padding: 25px;
            max-width: 420px;
            margin: 30px auto;
            border: 2px solid #f39c12;
        }
        h1 { color: #f39c12; }
        .joke-box {
            background: #0d0d1a;
            border-radius: 12px;
            padding: 20px;
            margin: 15px 0;
            font-size: 1.2rem;
            line-height: 2;
            min-height: 60px;
            border: 1px solid #444;
        }
        button {
            background: #f39c12;
            color: black;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            font-family: Tahoma;
            margin: 5px;
        }
        button:hover { background: #e67e22; }
        .copy-btn { background: #533483; color: white; }
        .copy-btn:hover { background: #6c3fa0; }
        #counter { color: #aaa; margin-top: 10px; }
        #emoji { font-size: 3rem; }
    </style>
</head>
<body>

<div class="box">
    <h1>😂 جوک ساز</h1>
    <div id="emoji">🤣</div>

    <div class="joke-box" id="jokeText">دکمه رو بزن!</div>

    <button onclick="newJoke()">🎲 جوک جدید</button>
    <button class="copy-btn" onclick="copyJoke()">📋 کپی</button>

    <p id="counter">تا حالا ۰ جوک دیدی</p>
</div>

<script>
    var jokes = [
        'به یکی میگن چرا خوشحالی؟ میگه فهمیدم امروز دوشنبه نیست! 😂',
        'یارو میره دکتر میگه با چای چشمم درد میگیره! دکتر میگه قاشق رو از لیوان دربیار! 🥄',
        'به سوسکه میگن چرا تند راه میری؟ میگه خونمون سر کوچه‌ست گم میشم! 🐞',
        'یارو میره نونوایی میگه نون داری؟ میگه نه! میگه پس چرا آرد داری؟ میگه برف اومده! ❄️',
        'گربه میگه هر چی میگم میو فکر میکنن غذا میخوام، من فقط غر میزنم! 🐱',
        'دو تا مورچه میرسن، یکی میگه کجا؟ میگه باشگاه، میخوام شش تیکه بشم! 💪',
        'به تخم مرغ میگن چرا میترسی؟ میگه هرکی منو میبینه میگه بزنمت! 🥚',
        'یارو میره آرایشگاه میگه طوری بزن مادرم نشناسه! میگه باشه کچلت میکنم! 💇',
        'به آینه میگن چرا جدی هستی؟ میگه هرکی نگاه میکنه قیافه‌ش رو درمیاره! 🪞',
        'به ساعت میگن چرا عجله داری؟ میگه وقت طلاست! ⏰',
        'یارو میره کتابفروشی میگه کتاب میلیونر شدن دارید؟ فروشنده میگه آره! میگه پس چرا اینجایی؟ 📚',
        'به کفش میگن چرا دوتایی هستید؟ میگه تنها باشیم لنگ میزنیم! 👟',
        'یارو میره دکتر میگه آمپول رو از راه دور بزن، از نزدیک میترسم! 💉',
        'به مداد میگن چرا کوتاه شدی؟ میگه هر روز سرم رو میتراشن! ✏️',
        'یارو خواب میبینه داره جوک تعریف میکنه، از خنده از تخت میفته! 😴'
    ];

    var count = 0;

    function newJoke() {
        var random = Math.floor(Math.random() * jokes.length);
        document.getElementById('jokeText').innerHTML = jokes[random];
        count++;
        document.getElementById('counter').innerHTML = 'تا حالا ' + count + ' جوک دیدی';
        
        var emojis = ['😂','🤣','😆','😹','😁','🤪','😜','🙃'];
        var randomEmoji = emojis[Math.floor(Math.random() * emojis.length)];
        document.getElementById('emoji').innerHTML = randomEmoji;
    }

    function copyJoke() {
        var text = document.getElementById('jokeText').innerHTML;
        navigator.clipboard.writeText(text).then(function() {
            alert('✅ جوک کپی شد!');
        });
    }

    // اولین جوک
    newJoke();
</script>
</body>
